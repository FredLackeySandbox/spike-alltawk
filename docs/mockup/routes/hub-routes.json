        "visibility": "string",
        "matchingMode": "string"
      }
    },
    {
      "operationId": "hub.retrieve-listed-tag-suggestions",
      "method": "GET",
      "path": "/api/v0/hub/retrieve-listed-tag-suggestions",
      "description": "Retrieve listed tag suggestions.",
      "inputs": {
        "partialTag": "string",
        "selectedTag": "string[]"
      }
    },
    {
      "operationId": "hub.search-listed-conversations",
      "method": "GET",
      "path": "/api/v0/hub/search-listed-conversations",
      "description": "Search listed conversations.",
      "inputs": {
        "selectedTag": "string[]"
      }
    },
    {
      "operationId": "hub.join-listed-conversation",
      "method": "POST",
