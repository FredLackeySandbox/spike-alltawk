      "messages": [
        {
          "id": "m-101",
          "authorId": "id-halvard",
          "at": "2026-08-01T09:14:00Z",
          "time": "9:14 AM",
          "text": "Element 3 on my KM-1027 went open circuit halfway through a bisque last night. Reading infinite across the terminals, the other two are sitting at 18.4 ohms.",
          "reactions": []
        },
        {
          "id": "m-102",
          "authorId": "id-kilnbot",
          "at": "2026-08-01T09:15:00Z",
          "time": "9:15 AM",
          "text": "Firing 2026-07-31 aborted at 04:12. Segment 3 of 4, 1642°F. Ramp rate had fallen to 41°F/hr against a target of 108°F/hr.",
          "reactions": []
        },
        {
          "id": "m-103",
          "authorId": "id-priya",
          "at": "2026-08-01T09:21:00Z",
          "time": "9:21 AM",
          "text": "@halvard-l That trailing rate is the giveaway. A failed relay cuts out cleanly instead of falling off over an hour.",
          "reactions": [
            {
              "emoji": "👍",
              "identityIds": [
                "id-halvard"
              ]
            }
          ]
        },
        {
          "id": "m-104",
          "authorId": "id-marisol",
          "at": "2026-08-01T09:33:00Z",
          "time": "9:33 AM",
          "text": "Check the pigtail connection before you order anything. Mine read open at the terminal and the element itself was fine — the crimp had burned back inside the connector where you cannot see it.",
          "reactions": [
            {
              "emoji": "🔥",
              "identityIds": [
                "id-priya",
                "id-halvard"
              ]
            }
          ]
        },
        {
          "id": "m-105",
          "authorId": "id-halvard",
          "at": "2026-08-01T10:02:00Z",
          "time": "10:02 AM",
          "text": "Pulled the cover. Connector is charred right through. Good call.",
          "reactions": [
            {
              "emoji": "✅",
              "identityIds": [
                "id-marisol",
                "id-priya",
                "id-junie"
              ]
            }
          ],
          "note": {
            "authorId": "id-priya",
            "authorName": "Priya Raghunathan",
            "body": "Ordered two 1027-PT pigtail kits on 31 Jul, arriving Tuesday."
          }
        },
        {
          "id": "m-106",
          "authorId": "id-renata",
          "at": "2026-08-01T10:40:00Z",
          "time": "10:40 AM",
          "text": "Skutt sells the replacement as part 1027-PT, about $14 for the pair. Do not reuse the old porcelain wire nuts, they are single-use once they have been heat cycled.",
          "reactions": [
            {
              "emoji": "🙏",
              "identityIds": [
                "id-halvard"
              ]
            }
          ]
        },
        {
          "id": "m-107",
          "authorId": "id-priya",
          "at": "2026-08-01T11:05:00Z",
          "time": "11:05 AM",
          "text": "Worth saying out loud: that element set is at 340 hours. If one connector cooked, the other two are the same age and have seen the same cycles.",
          "reactions": []
        },
        {
