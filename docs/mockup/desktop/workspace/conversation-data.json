        {
          "id": "m-801",
          "authorId": "id-oskar",
          "at": "2026-07-31T15:00:00Z",
          "time": "3:00 PM",
          "text": "Wadding recipe that actually releases: equal parts alumina hydrate and EPK, a pinch of sawdust. Nothing sticks and it crumbles off cold.",
          "reactions": [
            {
              "emoji": "✅",
              "identityIds": [
                "id-noor"
              ]
            }
          ]
        },
        {
          "id": "m-802",
          "authorId": "id-noor",
          "at": "2026-07-31T15:30:00Z",
          "time": "3:30 PM",
          "text": "How much salt are you introducing per cubic foot? Ours is coming out patchy on the back stack.",
          "reactions": []
        },
        {
          "id": "m-803",
          "authorId": "id-oskar",
